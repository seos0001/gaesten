---
const {
  ugetal = "UGE 27",
  guest1,
  guest2,
  guest3,
  guest4,
  guest5,
  guest6,
  logoPath = "/gaesten_logo.svg",
} = Astro.props;
---

<div
  class="transition-colors duration-300 w-150 max-w-4xl mx-auto border"
  style="background-color: var(--gul-300); border-color: var(--rød-500);"
  onmouseover="this.style.backgroundColor='var(--gul-500)'" 
  onmouseout="this.style.backgroundColor='var(--gul-300)'"
>

  <div class="flex flex-row items-start gap-8 p-10">
    
    <!-- Logo-kolonne -->
    <div class="w-20 flex-shrink-0 flex items-center">
      <img
        src={logoPath}
        alt="Gæsten logo"
        class=""
      />
    </div>

    <!-- Tekstindhold -->
    <div class="flex flex-col gap-6">
      <div class="text-3xl font-mono border-2 border-black rounded-full px-6 py-1 w-fit">
        {ugetal}
      </div>
      <ul class="text-xl font-mono space-y-2 leading-snug">
        {guest1 && <li><a href="/tickets_02">{guest1}</a></li>}
        {guest2 && <li><a href="/tickets_02">{guest2}</a></li>}
        {guest3 && <li><a href="/tickets_02">{guest3}</a></li>}
        {guest4 && <li><a href="/tickets_02">{guest4}</a></li>}
        {guest5 && <li><a href="/tickets_02">{guest5}</a></li>}
        {guest6 && <li><a href="/tickets_02">{guest6}</a></li>}
      </ul>
    </div>

  </div>
</div>







