---
const {
  ugetal = "UGE 27",
  guest1,
  guest2,
  guest3,
  guest4,
  guest5,
  guest6,
  logoPath = "/gaesten_logo.svg",
  bgcolor = "bg-[--gul-300]"
} = Astro.props;
---

<div class={`p-6 flex flex-row gap-8 w-full items-stretch outline-1`}>
  <!-- Venstre kolonne med logo -->
  <div class="flex-none h-full">
    <img
      src={logoPath}
      alt="Gæsten logo"
      class="h-full w-auto object-contain -rotate-90"
      style="transform-origin: center;"
    />
  </div>

  <!-- Højre indhold -->
  <div class="flex flex-col justify-end">
    <!-- Ugetal med oval -->
    <div class="text-4xl border-2 border-black px-6 py-1 rounded-full inline-block w-fit mb-6">
      {ugetal}
    </div>

    <!-- Gæsteliste -->
    <ul class="space-y-2 text-2xl">
      {guest1 && <li>{guest1}</li>}
      {guest2 && <li>{guest2}</li>}
      {guest3 && <li>{guest3}</li>}
      {guest4 && <li>{guest4}</li>}
      {guest5 && <li>{guest5}</li>}
      {guest6 && <li>{guest6}</li>}
    </ul>
  </div>
</div>


