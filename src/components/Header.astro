---
---

<header
  style="background: linear-gradient(to bottom, var(--gul-500), var(--gul-200));"
  class="relative py-10 px-10 flex justify-between items-center"
>
  <!-- Logo -->
  <a href="/">
    <img src="/g_logo.svg" alt="Logo" class="h-12" />
  </a>

  <!-- Desktop navigation -->
  <nav class="hidden lg:flex space-x-10 text-black">
    <a href="/tickets">Billetter</a>
    <a href="/#program">Program</a>
    <a href="/info">Info</a>
    <a href="/contact">Kontakt</a>
    <a href="#folkemoede">Folkemøde</a>
  </nav>

  <!-- Burger -->
  <button id="menu-toggle" class="lg:hidden flex flex-col space-y-1 w-8 h-8 z-40">
    <span class="bg-black h-[2px] w-full"></span>
    <span class="bg-black h-[2px] w-full"></span>
    <span class="bg-black h-[2px] w-full"></span>
  </button>

  <!-- Mobilmenu -->
  <nav
    id="mobile-menu"
    class="hidden fixed inset-0 bg-yellow-100 p-8 flex-col items-end z-50"
  >
    <button id="close-menu" class="mb-8">&times;</button>
    <div class="flex flex-col space-y-6 items-end text-right w-full pr-4">
      <a href="/tickets" class="hover:underline">Billetter</a>
      <a href="/#program" class="hover:underline">Program</a>
      <a href="/info" class="hover:underline">Info</a>
      <a href="/contact" class="hover:underline">Kontakt</a>
      <a href="#folkemoede" class="hover:underline">Folkemøde</a>
    </div>
  </nav>
</header>

<script is:inline>
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("close-menu");
  const menu = document.getElementById("mobile-menu");

  toggle.addEventListener("click", () => menu.classList.remove("hidden"));
  close.addEventListener("click", () => menu.classList.add("hidden"));
</script>

  