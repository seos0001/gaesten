---
const {
  ugetal = "",
  guest1,
  guest2,
  guest3,
  guest4,
  guest5,
  guest6,
  logoPath = "/gaesten_logo-drejet.svg",
} = Astro.props;
---

<section class="container mx-auto px-4">
  <div class="flex w-full max-w-3xl h-[320px] bg-(--gul-300) overflow-hidden" style="width: 550px;">
    <!-- Venstre kolonne med logo -->
    <div class="w-16 flex-shrink-0 flex items-center justify-center">
      <img
        src={logoPath}
        alt="Gæsten logo"
        class="h-72 w-auto object-contain"
      />
    </div>

    <!-- Højre kolonne -->
    <div class="flex flex-col grow p-6 justify-between">
      <!-- Ugetal -->
      <div class="grow self-end">
        <h2 class="px-6 py-1 rounded-full inline-block">
          {ugetal}
        </h2>
      </div>

      <!-- Gæsteliste placeret i bunden -->
      <div class="flex-grow flex items-end overflow-hidden">
        <ul class="space-y-2 leading-snug w-full overflow-y-hidden">
          {guest1 && <li><a href="/tickets02" class="hover:underline">{guest1}</a></li>}
          {guest2 && <li><a href="/tickets02" class="hover:underline">{guest2}</a></li>}
          {guest3 && <li><a href="/tickets02" class="hover:underline">{guest3}</a></li>}
          {guest4 && <li><a href="/tickets02" class="hover:underline">{guest4}</a></li>}
          {guest5 && <li><a href="/tickets02" class="hover:underline">{guest5}</a></li>}
          {guest6 && <li><a href="/tickets02" class="hover:underline">{guest6}</a></li>}
        </ul>
      </div>
    </div>
  </div>
</section>













