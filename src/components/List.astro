---
const {
  ugetal = "",
  guest1,
  guest2,
  guest3,
  guest4,
  guest5,
  guest6,
  logoPath = "/gaesten_logo.svg",
} = Astro.props;
---

<section class="max-w-4xl mx-auto px-4">
  <div class="flex flex-row bg-(--gul-300) shadow-md rounded overflow-hidden min-h-[400px] transition-all duration-300">
    <!-- Venstre kolonne med logo -->
    <div class="w-20 flex-shrink-0 flex items-center justify-center bg-amber-200">
      <img
        src={logoPath}
        alt="Gæsten logo"
        class="h-32 w-auto object-contain -rotate-90"
      />
    </div>

    <!-- Højre kolonne -->
    <div class="flex flex-col flex-grow p-6 justify-between">
      <!-- Ugetal -->
      <div class="text-right mb-4">
        <p class="text-2xl font-bold">{ugetal}</p>
      </div>

      <!-- Gæsteliste -->
      <div class="flex-grow flex items-center">
        <ul class="space-y-2 text-lg w-full">
          {guest1 && <li><a href="/tickets02" class="hover:underline">{guest1}</a></li>}
          {guest2 && <li><a href="/tickets02" class="hover:underline">{guest2}</a></li>}
          {guest3 && <li><a href="/tickets02" class="hover:underline">{guest3}</a></li>}
          {guest4 && <li><a href="/tickets02" class="hover:underline">{guest4}</a></li>}
          {guest5 && <li><a href="/tickets02" class="hover:underline">{guest5}</a></li>}
          {guest6 && <li><a href="/tickets02" class="hover:underline">{guest6}</a></li>}
        </ul>
      </div>
    </div>
  </div>
</section>











