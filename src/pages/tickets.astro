---
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import { Image } from 'astro:assets';
import thumbsup from "../assets/images/thumbsup.png";
import himmel from "../assets/images/himmel.webp"
import Formular from "../components/Formular.astro";
---
<MainLayout title="Tickets">
  <div class="relative h-[90vh]">
    <!-- Billede bag teksten -->
    <div class="absolute inset-0 -z-10 h-[90vh]">
      <img src={himmel.src} alt="Himmel" class="w-full h-full object-cover object-center" />
    </div>

	  <!-- Info-boks -->
	  <div class="bg-yellow-500 text-sm p-4 w-fit ml-10 mb-10 border-l-4 bg-[--blå-600] shadow">
		<p> * Alle koncerter starter kl 20.00.<br />Langbordsmiddag serveres kl 17.30 inden koncertstart</p>
	  </div>
    	  <!-- Formular -->
        <Formular />

</MainLayout>