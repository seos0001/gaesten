---
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import List from '../components/List.astro';
import { Image } from 'astro:assets';
import himmel from "../assets/images/himmel.webp";
import img1 from "../assets/images/img1.webp";
import peter_sommer from "../assets/images/peter_sommer.webp";
import goss_schoolofx from "../assets/images/goss_schoolofx.webp";
import brimheim_angmig from "../assets/images/brimheim_angmig.webp";
import selma_elias from "../assets/images/selma_elias.webp";
import oesten_soen from "../assets/images/oesten_soen.webp";
import star from "../assets/images/star.svg";
---

<MainLayout title="Gæsten Festival 2025">
<!-- Hero billede-karrusel med CTA og info -->
<div class="relative w-full h-[65vh] overflow-hidden text-white">
  <!-- Billeder -->
  <div class="absolute inset-0 z-0">
    <div class="w-full h-full relative">
      <div class="absolute inset-0 transition-opacity duration-[500ms] ease-in-out opacity-100" data-hero-slide>
        <img src={goss_schoolofx.src} alt="Slide 1" class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0 transition-opacity duration-[500ms] ease-in-out opacity-0" data-hero-slide>
        <img src={brimheim_angmig.src} alt="Slide 2" class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0 transition-opacity duration-[500ms] ease-in-out opacity-0" data-hero-slide>
        <img src={selma_elias.src} alt="Slide 3" class="w-full h-full object-cover" />
      </div>
      <div class="absolute inset-0 transition-opacity duration-[500ms] ease-in-out opacity-0" data-hero-slide>
        <img src={oesten_soen.src} alt="Slide 4" class="w-full h-full object-cover" />
      </div>
    </div>


  </div>

  <!-- Hero tekst + CTA -->
  <div class="relative z-20 h-full flex flex-col items-center justify-center text-center px-6 max-w-3xl mx-auto">
    <img src={star.src} alt="Stjerne" class="w-20 h-20 mb-4 animate-pulse" />

    <h1 class="text-3xl md:text-4xl font-bold leading-snug mb-4 drop-shadow">
      Velkommen til Gæsten Festival 2025
    </h1>

    <p class="text-base md:text-lg mb-6 drop-shadow text-white/90">
      I år får du noget helt nyt: <strong>dobbeltkoncerter</strong> – to kunstnere samme aften, til én og samme pris!
    </p>

    <div class="mb-6">
      <Button href="/tickets" label="Køb billet nu" />
    </div>

    <!-- Scroll indikator -->
    <div class="absolute bottom-6 flex flex-col items-center text-sm text-white/70">
      <span class="mb-1">Scroll</span>
      <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>
</div>



  <!-- 5 forskudte List-komponenter med himmelbaggrund -->
  <section class="relative w-full px-6 py-16 text-black" style={`background-image: url('${himmel.src}'); background-size: cover; background-attachment: fixed; background-position: center;`}>
    <div class="max-w-6xl mx-auto">
  
      <!-- Overskrift -->
      <h2 class="font-kapakana text-center mb-12 text-[42px] animate-pulse" style="color: var(--rød-500); -webkit-text-stroke: 1px black;">
        Program for 2025
      </h2>
  
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 px-4">
  
        <!-- Venstre kolonne – 2 lister forskudt -->
        <div class="flex flex-col gap-16 justify-center md:translate-y-12">
          <List ugetal="UGE 28" guest1="8.7 Benjamin Hav & Familien" guest2="9.7 Benjamin Hav & Familien" guest3="10.7 Goss + School of X" guest4="11.7 MØ" guest5="12.7 Soleima" logoPath="/gaesten_logo-drejet.svg" />
          <List ugetal="UGE 30" guest1="22.7 Brimheim + Angående mig" guest2="23.7 Peter Sommer" guest3="24.7 Hugorm" guest4="25.7 Malte Ebert" guest5="26.8 Selma Judith + Elias Rønnenfelt" logoPath="/gaesten_logo-drejet.svg" />
        </div>
  
        <!-- Højre kolonne – 3 lister -->
        <div class="flex flex-col gap-10">
          <List ugetal="UGE 27" guest1="3.7 Marie Key (duo)" guest2="4.7 The Minds of 99" guest3="5.7 The Minds of 99" logoPath="/gaesten_logo-drejet.svg" />
          <List ugetal="UGE 29" guest1="15.7 Barselona" guest2="16.7 Emma Sehested Høegh" guest3="18.7 Teitur (solo)" guest4="19.7 APHACA" logoPath="/gaesten_logo-drejet.svg" />
          <List ugetal="UGE 31" guest1="28.7 Caroline Henderson" guest2="29.7 Andreas Odbjerg" guest3="30.7 Østen + Søn" guest4="31.7 Jada" guest5="1.8 Benny Jamz" guest6="2.8 TV·2" logoPath="/gaesten_logo-drejet.svg" />
        </div>
  
      </div>
  
      <!-- Fremhæv Peter Sommer henover skyerne -->
      <div class="relative z-20 w-full flex justify-center">
        <div class="max-w-xl w-full">
          <img src={peter_sommer.src} alt="Peter Sommer" class="w-full object-cover shadow-lg" />
        </div>
      </div>
    </div>
  </section>

  <!-- Script til billedrotation -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('[data-hero-slide]');
      let current = 0;

      setInterval(() => {
        slides[current].classList.remove('opacity-100');
        slides[current].classList.add('opacity-0');

        current = (current + 1) % slides.length;

        slides[current].classList.remove('opacity-0');
        slides[current].classList.add('opacity-100');
      }, 4000); // 4 sekunder mellem slides
    });
  </script>
</MainLayout>






