---
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import { Image } from 'astro:assets';
import thumbsup from "../assets/images/thumbsup.png";
import himmel from "../assets/images/himmel.webp"
import Formular02 from "../components/Formular.astro";
import star from "../assets/images/star.svg"; // Sørg for at filnavnet og sti stemmer
---
<MainLayout title="Tickets">
  <div class="relative h-[90vh]">
    <!-- Billede bag teksten -->
    <div class="absolute inset-0 -z-10 h-[90vh]">
      <img src={himmel.src} alt="Himmel" class="w-full h-full object-cover object-center" />
    </div>

	  <!-- Info-boks -->
    <div class="text-sm p-4 w-fit ml-10 mb-10 bg-(--blå-600) shadow">
		<p> * Alle koncerter starter kl 20.00.<br />Langbordsmiddag serveres kl 17.30 inden koncertstart</p>
	  </div>
    	  <!-- Formular -->
        <Formular02 />
    <!-- Sliding banner -->
    <div class="h-12 overflow-hidden mb-6 bg-[var(--blå-600)] w-screen">
      <div class="animate-marquee whitespace-nowrap flex items-center h-full">
        <p class="mx-4">Spillested med levende musik</p>
        <img src={star.src} alt="Stjerne" class="w-5 h-5 mx-2" />
        <p class="mx-4">Hvor de sprøde spiller, spiser og sover</p>
        <img src={star.src} alt="Stjerne" class="w-5 h-5 mx-2" />
        <p class="mx-4">Sommerferie på toppen af øen</p>
        <img src={star.src} alt="Stjerne" class="w-5 h-5 mx-2" />
