        <img src={star.src} alt="Stjerne" class="w-5 h-5 mx-2" />
        <p class="mx-4">Hvor de sprøde spiller, spiser og sover</p>
        <img src={star.src} alt="Stjerne" class="w-5 h-5 mx-2" />
        <p class="mx-4">Sommerferie på toppen af øen</p>
