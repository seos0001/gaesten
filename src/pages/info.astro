---
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import { Image } from 'astro:assets';
import gaesten_ring from "../assets/images/gaesten_ring.webp";
import koncert from "../assets/images/koncert.webp";
import toerresnor from "../assets/images/toerresnor.webp";
import blomster from "../assets/images/blomster.webp";
import placering from "../assets/images/placering.webp";
---

<MainLayout title="Info - Gæsten">
		<section class="bg-[#fefcd7] text-black px-6 md:px-16 py-16 space-y-24">
		  
		  <!-- GÆSTEN intro -->
		  <div class="grid md:grid-cols-2 gap-10 items-center">
			<img src={gaesten_ring.src} alt="Gæstgiveren" class="w-full object-cover rounded" />
			<div>
			  <h1 class="tracking-wide mb-4">GÆSTEN</h1>
			  <p class="space-y-4 text-lg leading-relaxed">
				<!-- Indsæt tekst her -->
			  </p>
			</div>
		  </div>
	  
		  <!-- MUSIK & LANGBORDSMIDDAG -->
		  <div class="grid md:grid-cols-2 gap-10 items-center">
			<div class="order-2 md:order-1">
			  <h2 class="">MUSIK & LANGBORDSMIDDAG</h2>
			  <p class="space-y-4 text-lg leading-relaxed">
				<!-- Indsæt tekst her -->
			  </p>
			</div>
			<img src={koncert.src} alt="Koncert og middag" class="w-full object-cover rounded order-1 md:order-2" />
		  </div>
	  
		  <!-- SOMMERHUS HELE ÅRET -->
		  <div class="grid md:grid-cols-2 gap-10 items-center">
			<img src={toerresnor.src} alt="Sommerhus hele året" class="w-full object-cover rounded" />
			<div>
			  <h2 class="">SOMMERHUS HELE ÅRET</h2>
			  <p class="space-y-4 text-lg leading-relaxed">
				<!-- Indsæt tekst her -->
			  </p>
			</div>
		  </div>
	  
		  <!-- PLADS TIL FEST -->
		  <div class="grid md:grid-cols-2 gap-10 items-center">
			<div class="order-2 md:order-1">
			  <h2 class="">PLADS TIL FEST</h2>
			  <p class="space-y-4 text-lg leading-relaxed">
				<!-- Indsæt tekst her -->
			  </p>
			</div>
			<img src={blomster.src} alt="Plads til fest" class="w-full object-cover rounded order-1 md:order-2" />
		  </div>
	  
		  <!-- PLACERING -->
		  <div class="grid md:grid-cols-2 gap-10 items-center">
			<img src={placering.src} alt="Placering" class="w-full object-cover rounded" />
			<div>
			  <h2 class="">PLACERING</h2>
			  <p class="space-y-4 text-lg leading-relaxed">
				<!-- Indsæt tekst her -->
			  </p>
			</div>
		  </div>
	  
		  <!-- Afslutning -->
		  <div class="text-center mt-20">
			<p class="text-2xl italic text-red-700">Vi ses til eventyr på<br />Gæsten i Allinge!</p>
		  </div>
</MainLayout>
